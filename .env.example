# MariaDB Data Lab configuration. Copy to .env and adjust. Never commit .env.

# --- Web server -------------------------------------------------------------
# Bind to loopback by default. If you bind to another interface, set APP_ACCESS_TOKEN.
APP_HOST=127.0.0.1
APP_PORT=8080
# Bearer token required for every /api request (entered in Settings). At least 16 characters.
# Required when APP_HOST is not a loopback address: the server refuses to start without it.
APP_ACCESS_TOKEN=
# Extra Host header names accepted (comma-separated), e.g. the name of a reverse proxy.
# Loopback names are always accepted on a loopback bind.
APP_ALLOWED_HOSTS=
# Allow the Connections page to replace the profile at runtime (kept in memory only).
# Defaults to true on a loopback bind and false otherwise.
ALLOW_CONNECTION_OVERRIDE=true
LOG_LEVEL=info

# --- Runtime account (SELECT, INSERT, UPDATE, DELETE on the lab schema) -----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=datalab_app
DB_PASSWORD=change-me
# Dedicated lab schema. The app refuses to install into a schema with foreign tables.
DB_NAME=datalab
DB_CONNECT_TIMEOUT_MS=10000
DB_POOL_SIZE=10
# disabled | verify | skip-verify
DB_SSL=disabled
# Path (on the server) to a PEM CA bundle, used when DB_SSL=verify.
DB_SSL_CA=

# --- Administrative account (DDL: CREATE, ALTER, DROP, INDEX, REFERENCES ...) -
# Used only for schema creation and cleanup (TRUNCATE). Leave empty to use the runtime account.
DB_ADMIN_USER=datalab_admin
DB_ADMIN_PASSWORD=change-me-too
# Optional comma-separated list of hosts the Connections page may switch to (empty = any).
DB_OVERRIDE_HOST_ALLOWLIST=

# --- Safety limits ----------------------------------------------------------
GEN_MAX_WORKERS=8
GEN_MAX_TOTAL_ROWS=60000000
# Runs estimated above this many rows require explicit confirmation.
GEN_CONFIRM_ROWS_THRESHOLD=1000000
VALIDATION_STATEMENT_TIMEOUT_SEC=300

# --- Dataset import ---------------------------------------------------------
# Directory holding the Olist CSV files (relative paths are resolved from the project root).
DATASET_DIR=datasets/raw
# Maximum size of one uploaded CSV file.
IMPORT_MAX_UPLOAD_MB=1024

# --- Performance Lab ----------------------------------------------------------
# Hard limits for one benchmark run.
BENCH_MAX_CONCURRENCY=32
BENCH_MAX_DURATION_SEC=600
# Runs above either threshold need explicit (typed) confirmation.
BENCH_HEAVY_CONCURRENCY=8
BENCH_HEAVY_DURATION_SEC=60
# Iteration-mode runs above this many operations (or above 1M rows written) need confirmation too.
BENCH_HEAVY_ITERATIONS=100000
